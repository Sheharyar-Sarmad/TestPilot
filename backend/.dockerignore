# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never bake .env into the image
.env
.env.*
!.env.example

# Git and IDE
.git/
.gitignore
.vscode/
.idea/

# Logs and temp
*.log
logs/
tmp/

# Docker files (don't copy these into the image)
Dockerfile*
docker-compose*.yml